# Preencha apenas no arquivo .env local ou em Environment na FadeHost.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Local: ./data. Na FadeHost use /data/ascendio (fora de /data/app).
DATA_DIR=./data
# Opcionais: usados somente na criação inicial do state.json.
WELCOME_CHANNEL_ID=
LOG_CHANNEL_ID=
ADMIN_ROLE_IDS=
# Cargo automático para novos membros humanos; vazio desativa. O bot deve estar acima dele.
JOIN_ROLE_ID=
# Registra comandos do servidor na inicialização; desative após o primeiro deploy se desejar.
REGISTER_COMMANDS_ON_START=true
# Opcional: JSON de configuração inicial de tickets; veja docs/TICKETS.md.
# Usado somente para criar tickets.json; não substitui ajustes feitos no Discord.
TICKETS_CONFIG=
